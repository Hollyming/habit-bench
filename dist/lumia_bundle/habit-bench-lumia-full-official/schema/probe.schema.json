{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HABIT-Bench Probe",
  "type": "object",
  "required": [
    "probe_id",
    "user_id",
    "split",
    "probe_type",
    "habit_family",
    "query",
    "choices",
    "validator",
    "visible_history_scope",
    "metadata"
  ],
  "properties": {
    "probe_id": { "type": "string" },
    "user_id": { "type": "string" },
    "split": { "type": "string", "enum": ["dev", "test", "stress"] },
    "probe_type": {
      "type": "string",
      "enum": [
        "direct_use",
        "boundary",
        "exception",
        "drift",
        "evidence",
        "ask_act",
        "privacy"
      ]
    },
    "habit_id": { "type": ["string", "null"] },
    "habit_family": { "type": "string" },
    "query": { "type": "string", "minLength": 10 },
    "choices": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["choice_id", "text"],
        "properties": {
          "choice_id": { "type": "string" },
          "text": { "type": "string" }
        }
      }
    },
    "validator": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "type": "string" },
        "gold_choice_id": { "type": "string" },
        "gold_action": { "type": "string" }
      }
    },
    "visible_history_scope": {
      "type": "object",
      "required": ["user_id", "max_session_index"],
      "properties": {
        "user_id": { "type": "string" },
        "max_session_index": { "type": "integer" }
      }
    },
    "metadata": { "type": "object" }
  }
}
