{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HABIT-Bench Normalized Public Probe",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "probe_id",
    "user_id",
    "domain",
    "query",
    "choices",
    "visible_history_scope"
  ],
  "properties": {
    "probe_id": {"type": "string", "minLength": 1},
    "user_id": {"type": "string", "minLength": 1},
    "domain": {"type": "string", "minLength": 1},
    "timestamp": {"type": ["string", "null"]},
    "query": {"type": "string", "minLength": 1},
    "choices": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["choice_id", "text"],
        "properties": {
          "choice_id": {"type": "string", "minLength": 1},
          "text": {"type": "string", "minLength": 1}
        }
      }
    },
    "visible_history_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["user_id", "max_session_index"],
      "properties": {
        "user_id": {"type": "string", "minLength": 1},
        "max_session_index": {"type": "integer", "minimum": 0}
      }
    },
    "split": {"type": "string"},
    "metadata": {"type": "object"}
  }
}
