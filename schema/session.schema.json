{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HABIT-Bench Session",
  "type": "object",
  "required": [
    "session_id",
    "user_id",
    "session_index",
    "timestamp",
    "domain",
    "messages",
    "source_seed",
    "memory_annotations"
  ],
  "properties": {
    "session_id": { "type": "string" },
    "user_id": { "type": "string" },
    "session_index": { "type": "integer" },
    "timestamp": { "type": "string" },
    "domain": { "type": "string" },
    "messages": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["role", "content"],
        "properties": {
          "role": { "type": "string", "enum": ["user", "assistant"] },
          "content": { "type": "string" }
        }
      }
    },
    "source_seed": {
      "type": "object",
      "required": ["source_dataset", "seed_id", "domain"],
      "properties": {
        "source_dataset": { "type": "string" },
        "seed_id": { "type": "string" },
        "domain": { "type": "string" }
      }
    },
    "memory_annotations": {
      "type": "object",
      "required": ["linked_habit_ids", "signal_type"],
      "properties": {
        "linked_habit_ids": {
          "type": "array",
          "items": { "type": "string" }
        },
        "signal_type": { "type": "string" }
      }
    }
  }
}
